# Local template only. Copy to .env or .env.local and replace the placeholders.
# Never commit real credentials or local environment files.

# Vera mini app URL launched by /start and /app (default: https://vera.report/)
#VERA_MINI_APP_URL=https://vera.report/

# ── MongoDB ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=vera

# Include every frontend origin for this environment; production requires HTTPS.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── IPFS (evidence storage) ──────────────────────────────────────────────────
# Self-hosted Kubo node (see integrations/ipfs/README.md). local-enclave is the
# only backend and is required; production also requires the archive bucket and
# an explicit URL.
IPFS_STORAGE_BACKEND=local-enclave
# ENCLAVE_IPFS_URL=http://127.0.0.1:15002
# IPFS_CIPHERTEXT_ARCHIVE_BUCKET=your-ciphertext-archive

# ── Venice AI (legacy scorer / health signal) ──────────────────────────────
VENICE_API_KEY=your_venice_api_key
VENICE_MODEL=llama-3.2-3b
VENICE_VERIFICATION_MODEL=mistral-31-24b

# ── Shroud confidential inference (report scoring) ─────────────────────────
SHROUD_API_KEY=""
SHROUD_BASE_URL=https://dev-gateway.shroud.us
SHROUD_MODEL=nemotron-3-ultra

# ── Encryption keys & internal secrets ─────────────────────────────────────
# Application master encryption key.
ENCRYPTION_MASTER_KEY=a-long-random-hex-string
# Encrypts reward-contact PII + report narrative at rest (AES-256-GCM; run through
# scrypt as a passphrase). Must be STABLE — changing it makes existing ciphertext
# undecryptable — and unique per environment. Required in production.
REWARD_ENCRYPTION_KEY=a-long-random-string-for-encrypting-reward-contacts
# Shared secret gating the Next.js admin proxy → Express backend calls
# (x-internal-secret). Without it the admin proxy endpoints 500. Generate with:
# openssl rand -hex 32
INTERNAL_API_SECRET=a-long-random-hex-string

# ── Server ──────────────────────────────────────────────────────────────────
API_PORT=3001
PORT=3000

# ── Auth0 ─────────────────────────────────────────────────────────────────
AUTH0_SECRET=a-long-random-string-hex-encoded-32-bytes
APP_BASE_URL=http://localhost:3000
# AUTH0_BASE_URL is a local-dev alias for APP_BASE_URL; not set on staging.
AUTH0_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
# Auth0 Management API (M2M app for RBAC user management)
AUTH0_MGMT_CLIENT_ID=your-m2m-client-id
AUTH0_MGMT_CLIENT_SECRET=your-m2m-client-secret

# ── AWS / SES email (admin alerts + dissemination adapters) ────────────────
AWS_REGION=us-east-2
SES_REGION=us-east-2
SES_SENDER_EMAIL=alerts@example.invalid

# ── Logging ─────────────────────────────────────────────────────────────────
# Verbosity gate for lib/../src/utils/logger (debug < info < warn < error).
# Default 'info' (operational logs visible, debug silent). Set 'debug' to see
# verbose/high-frequency logs (e.g. cron ticks),
# 'warn' to quiet everything but warnings/errors, or 'silent'.
LOG_LEVEL=info
# Set json for one JSON event per line. Unset preserves human-readable output.
# Pass safe operational fields as an object; never interpolate secrets/report content.
# LOG_FORMAT=json

# ── Block Explorer (frontend) ───────────────────────────────────────────────
# Links historical Midnight receipts on report status pages; no new proofs are issued.
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://preprod.midnightexplorer.com
# Network that explorer serves. Receipts recorded on another network (legacy
# receipts count as preprod) are shown without an explorer link.
NEXT_PUBLIC_BLOCK_EXPLORER_NETWORK=preprod

# ── Multi-tenancy (silo model — see docs/pdr/VERA-PDR-001-A1-multi-tenancy.md) ─
# All optional; unset = historical single-tenant behaviour. TENANT_ORG_ID is set
# on both staging and prod since the Auth0 org cutover.
# Admin email domains allowed for THIS deployment (comma-separated, '@' optional).
ADMIN_ALLOWED_DOMAINS=@yourcompany.com
# The Auth0 Organization this deployment serves. When set, an admin is rejected
# unless their token's org_id matches it (isolation on the shared Auth0 tenant).
TENANT_ORG_ID=org_xxxxxxxxxxxx
# Human-readable tenant name for branding (consent copy, packet cover letters).
TENANT_NAME=Vera

# ── Agency Dissemination Pipeline (VERA-PDR-001) — Tier A dry-run dispatch ──
# All optional; not set on staging (code defaults apply).
# Safety switch: 'dryrun' (default) routes agency emails to the internal
# inbox below instead of real agency addresses; 'live' dispatches for real.
DISSEMINATION_MODE=dryrun
DISSEMINATION_DRYRUN_INBOX=dissemination-test@your-domain.com
# Dedicated sender for agency submissions (falls back to SES_SENDER_EMAIL)
DISSEMINATION_SENDER_EMAIL=submissions@your-domain.com
# Receipt mailbox domain: agency replies go to <entityId>-receipts@<domain>
# via Reply-To. Leave unset to skip Reply-To.
DISSEMINATION_RECEIPT_DOMAIN=receipts.your-domain.com
# Inbound reply relay actually deployed? Only when 'true' do secure-packet emails
# attach a Reply-To AND tell the recipient they can reach the reporter by
# replying. Keep unset/false until the inbound relay (SES receipt rule + relay
# Lambda) is live — otherwise the mail promises a reply path that goes nowhere.
# Deliberately separate from DISSEMINATION_RECEIPT_DOMAIN, which also drives
# agency-receipt tracking and must not, on its own, resurrect that promise.
DISSEMINATION_RELAY_ENABLED=false
# HMAC secret (long random string) — REQUIRED once the pipeline is used: it
# signs inbound receipt/webhook callbacks AND mints the token-scoped counsel
# workspace links, evidence-escrow tokens, and one-time secure-packet links.
# If unset, those flows 500/throw.
# Stored in the vera/<env>/encryption secret. Generate with: openssl rand -hex 32
DISSEMINATION_WEBHOOK_SECRET=a-long-random-hex-string
# One-time secure disclosure-packet links (reporter-reward flow): a single-use,
# emailed link serving the identity-free dossier packet to an external recipient
# (e.g. a whistleblower attorney). Signed with DISSEMINATION_WEBHOOK_SECRET; the
# mode/dryrun-inbox/receipt-domain above are reused. TTL optional (default 7).
SECURE_LINK_TTL_DAYS=7
# Reward-recipient send addresses for the automatic on-submit send. JSON map of
# recipient id → email; the ids are the curated allowlist in
# src/services/dissemination/rewardRecipients.ts (the client only ever sends an
# id, the server resolves the address here). A recipient with no entry is only
# sendable in dryrun (routes to DISSEMINATION_DRYRUN_INBOX); a live send to it is
# skipped. Unset = every auto send routes to the dryrun inbox.
DISSEMINATION_RECIPIENT_EMAILS={"whistleblower-org":"intake@example.org"}

# Per-recipient PGP policies for agency email (JSON, lowercase email keys).
# Live email fails closed without a policy. See docs/dissemination-pgp.md.
# DISSEMINATION_EMAIL_POLICIES={"recipient@example.org":{"publicKey":"-----BEGIN PGP PUBLIC KEY BLOCK-----\n...","fingerprint":"FULL_PUBLIC_KEY_FINGERPRINT"}}
# Direct Slack notifications for accepted reports. Server-side only; optional.
# The webhook URL is a credential. Store in Secrets Manager, never NEXT_PUBLIC_*.
# SLACK_ADMIN_URL must be an HTTPS /admin URL with no query or fragment.
# Direct Slack takes precedence over the legacy webhook below; no dual send.
SLACK_WEBHOOK_URL=
SLACK_ADMIN_URL=

# Legacy outgoing notifications (n8n). Not needed for direct Slack or SES email.
# Leave URL empty to disable; when set, configure a separate random shared secret.
# Receiver must verify the X-VERA-Webhook-Secret header against WEBHOOK_SECRET.
WEBHOOK_URL=
WEBHOOK_SECRET=


# Independent >=32 random bytes; never reuse webhook/internal credentials. v2 links must be reissued.
RECIPIENT_CAPABILITY_SECRET=

# ── Confidential reports and legal organizations (OFF by default) ───────────
# Weekly submission totals: staging only, Monday 09:00 UTC. Use a dedicated
# Incoming Webhook bound to tech-vera-incoming-reports, never a NEXT_PUBLIC_ var.
# WEEKLY_SUBMISSION_SUMMARY_ENABLED=false
# SLACK_WEEKLY_SUMMARY_WEBHOOK_URL=
# Optional staff alerts (blank disables delivery; never reporter email).
# CONFIDENTIAL_SLACK_WEBHOOK_URL=
# CONFIDENTIAL_SLACK_ADMIN_URL=
# Optional legal application review webhook (staff-readable firm data only).
# SLACK_APPLICATION_WEBHOOK_URL=
# Isolated approval worker only: app-level xapp token for Socket Mode, and a bot
# xoxb token from the same app for the required typed Key ID confirmation dialog.
# SLACK_APPLICATION_APP_TOKEN=
# SLACK_APPLICATION_BOT_TOKEN=
# HTTP callback alternative: signing secret on the Next server only.
# SLACK_APPLICATION_SIGNING_SECRET=
# Policy belongs to whichever process receives decisions (isolated worker for Socket Mode).
# SLACK_APPLICATION_TEAM_ID=
# SLACK_APPLICATION_APPROVERS=
# Unrelated to Shroud above. Confidential reporting is the default; set
# NEXT_PUBLIC_CONFIDENTIAL_CASES=0 explicitly only for legacy intake. Each
# setting, which process reads it, and the startup constraints are documented in
# the same section of .env.frontend.example (browser build + Next server) and
# .env.backend.example (legacy API + the RUN_MODE=confidential task). In short:
# the confidential task needs CONFIDENTIAL_ADMIN_SECRET of at least 32
# characters, receives no legacy secret, and CONFIDENTIAL_MONGODB_DB_NAME must
# differ from MONGODB_DB_NAME. Shared local layout (one .env for Next and API):
# NEXT_PUBLIC_CONFIDENTIAL_CASES=0
# NEXT_PUBLIC_CONFIDENTIAL_RELEASE_MANIFEST=
# NEXT_PUBLIC_CONFIDENTIAL_RELEASE_NOTES=
# NEXT_PUBLIC_CONFIDENTIAL_WITHDRAWAL_KEY=
# NEXT_PUBLIC_LEGAL_AUTH0_DOMAIN=your-legal-tenant.auth0.com
# NEXT_PUBLIC_LEGAL_AUTH0_CLIENT_ID=your-legal-spa-client-id
# NEXT_PUBLIC_LEGAL_AUTH0_AUDIENCE=https://legal.example/api
# NEXT_PUBLIC_LEGAL_AUTH0_ORGANIZATION=
# NEXT_PUBLIC_ONBOARDING_AUTH0_DOMAIN=your-legal-tenant.auth0.com
# NEXT_PUBLIC_ONBOARDING_AUTH0_CLIENT_ID=your-onboarding-spa-client-id
# NEXT_PUBLIC_ONBOARDING_AUTH0_AUDIENCE=https://legal.example/onboarding
# NEXT_PUBLIC_ONBOARDING_AUTH0_ORGANIZATION=
# CONFIDENTIAL_CASES_ENABLED=false
# CONFIDENTIAL_MONGODB_DB_NAME=vera_confidential
# CONFIDENTIAL_RELEASE_MANIFEST_FILE=/path/to/release-manifest.json
# CONFIDENTIAL_LEGAL_IDENTITY_FILE=/path/to/legal-identity-policy.json
# Dedicated layout only (legacy API / Next server / confidential task):
# CONFIDENTIAL_INTAKE_REQUIRED=true
# CONFIDENTIAL_BACKEND_URL=http://localhost:3002
# CONFIDENTIAL_ADMIN_SECRET=replace-with-64-hex-characters-from-openssl-rand
# CONFIDENTIAL_MONGODB_URI=mongodb://localhost:27017

# Approved legal applications: backend-only legal-tenant M2M credentials.
# Use the dedicated legal provisioning M2M grants below. Never use staff credentials.
# Grants and pinned legal identity policy: see .env.backend.example and the legal-applications runbook.
# LEGAL_AUTH0_MGMT_DOMAIN=your-legal-tenant.auth0.com
# LEGAL_AUTH0_MGMT_CLIENT_ID=your-dedicated-legal-m2m-client-id
# LEGAL_AUTH0_MGMT_CLIENT_SECRET=your-dedicated-legal-m2m-secret
# Required whenever M2M provisioning is configured.
# LEGAL_AUTH0_CONNECTION_ID=con_existingLegalConnection
# These existing settings enable Auth0-only entry and background membership
# provisioning automatically. Requires update:organizations on the provisioning
# M2M and matching read-only Auth0 Actions; see docs/security/README.md (6. Auth0 legal tenant configuration).
