# Local template only. Replace placeholders with your own development configuration.
# Copy to .env.frontend.local for Docker Compose. Use development credentials only.
# This file is scoped to the frontend service; never copy a production env file here.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=vera
INTERNAL_API_SECRET=a-long-random-hex-string
# 0 for direct local requests; 2 only behind origin-verified CloudFront -> ALB.
FRONTEND_TRUST_PROXY_HOPS=0
AUTH0_SECRET=a-long-random-string-hex-encoded-32-bytes
APP_BASE_URL=http://localhost:3000
AUTH0_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_MGMT_CLIENT_ID=your-m2m-client-id
AUTH0_MGMT_CLIENT_SECRET=your-m2m-client-secret
AWS_REGION=us-east-2
SES_REGION=us-east-2
SES_SENDER_EMAIL=alerts@example.invalid
ADMIN_ALLOWED_DOMAINS=@yourcompany.com
TENANT_ORG_ID=org_xxxxxxxxxxxx
TENANT_NAME=Vera

# ── Confidential reports and legal organizations (OFF by default) ───────────
# Optional legal application Slack callback; secrets stay server-side.
# SLACK_APPLICATION_SIGNING_SECRET=
# SLACK_APPLICATION_TEAM_ID=
# SLACK_APPLICATION_APPROVERS=
# Confidential reporting is the default. Set NEXT_PUBLIC_CONFIDENTIAL_CASES=0
# explicitly only for legacy intake. Confidential reporting needs the
# matching backend settings in .env.backend.example (same section); under
# NODE_ENV=production the backend accepts it only with DEPLOY_ENV=prod, staging
# or rehearsal (src/utils/confidentialConfiguration.ts).
# See docs/security/README.md.
#
# Read by: [build] = compiled into the browser bundle by `next build` (a Docker
# build ARG; changing it needs a rebuild), [next] = the Next server at runtime.
#
# [build] Unset or 1 selects encrypted intake; 0 opts into legacy intake.
# A confidential build refuses to start without
# NEXT_PUBLIC_CONFIDENTIAL_RELEASE_MANIFEST (next.config.js).
# NEXT_PUBLIC_CONFIDENTIAL_CASES=0
# [build] Canonical release manifest JSON the reporter's browser verifies before
# sending anything (scripts/security/ builds it). Public, not a secret.
# NEXT_PUBLIC_CONFIDENTIAL_RELEASE_MANIFEST=
# [build] Optional operator notes shown when a reporter is asked to approve an update.
# NEXT_PUBLIC_CONFIDENTIAL_RELEASE_NOTES=
# [build] Optional base64 of the armored release-withdrawal public key
# (scripts/security/confidential-release-withdrawals.cjs keygen). Empty: off.
# NEXT_PUBLIC_CONFIDENTIAL_WITHDRAWAL_KEY=
# [build] Sign-in for legal organization members at /legal (PKCE, public client).
# All three of domain, client ID and audience are required or /legal sign-in is off;
# the organization is optional and must look like org_...
# NEXT_PUBLIC_LEGAL_AUTH0_DOMAIN=your-legal-tenant.auth0.com
# NEXT_PUBLIC_LEGAL_AUTH0_CLIENT_ID=your-legal-spa-client-id
# NEXT_PUBLIC_LEGAL_AUTH0_AUDIENCE=https://legal.example/api
# NEXT_PUBLIC_LEGAL_AUTH0_ORGANIZATION=
# Set to email for Auth0's passwordless email connection; enable it on the legal
# app and approved organizations, and use its ID for backend provisioning.
# NEXT_PUBLIC_LEGAL_AUTH0_CONNECTION=email
# [build] Separate sign-in used only to invite legal organizations
# (/legal/administration). Same rules as the legal sign-in above.
# NEXT_PUBLIC_ONBOARDING_AUTH0_DOMAIN=your-legal-tenant.auth0.com
# NEXT_PUBLIC_ONBOARDING_AUTH0_CLIENT_ID=your-onboarding-spa-client-id
# NEXT_PUBLIC_ONBOARDING_AUTH0_AUDIENCE=https://legal.example/onboarding
# NEXT_PUBLIC_ONBOARDING_AUTH0_ORGANIZATION=
# [next] true makes the Next submit proxy refuse plaintext (legacy) intake.
# CONFIDENTIAL_CASES_ENABLED=false
# [next] Admin "Encrypted" tab, dedicated layout only: internal URL of the
# RUN_MODE=confidential task (e.g. http://localhost:3002) and the same
# CONFIDENTIAL_ADMIN_SECRET that task uses (at least 32 characters, never
# INTERNAL_API_SECRET). Leave both unset in the shared layout: the tab then uses
# BACKEND_URL and INTERNAL_API_SECRET. A URL without the secret shows
# "Backend not configured" (pages/api/admin/confidential/listings.ts).
# CONFIDENTIAL_BACKEND_URL=
# CONFIDENTIAL_ADMIN_SECRET=
# [next, development only] Send /api/confidential to a local confidential-only
# task instead of the legacy API on :3001 (http://localhost:<port> only).
# VERA_DEV_CONFIDENTIAL_API_ORIGIN=
