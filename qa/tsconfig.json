{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node",
      "@playwright/test"
    ],
    "baseUrl": ".",
    "allowImportingTsExtensions": true
  },
  "include": [
    "*.config.ts",
    "fixture-tests/**/*.ts",
    "local-tests/**/*.ts",
    "e2e/**/*.ts",
    "dev/**/*.ts",
    "support/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "playwright-report",
    "test-results",
    ".auth"
  ]
}
