{
  "name": "vera",
  "version": "0.0.1",
  "license": "MIT",
  "scripts": {
    "start": "concurrently --kill-others-on-fail \"node dist/index.js\" \"next start\"",
    "start:alt": "concurrently --kill-others-on-fail \"node dist/index.js\" \"next start -p 3002\"",
    "start:dev": "NODE_OPTIONS=--max-old-space-size=8192 ts-node src/index.ts",
    "build": "tsc -p tsconfig.server.json && next build",
    "test": "jest --config jest.local.config.ts --verbose",
    "build:enclave": "node enclave/node_modules/typescript/bin/tsc -p enclave/tsconfig.json",
    "test:runtime": "npm run build:enclave && node --test tests/confidential-runtime/*.test.cjs",
    "dev": "next dev",
    "dev:full": "concurrently --kill-others-on-fail \"NODE_OPTIONS=--max-old-space-size=8192 node dist/index.js\" \"next dev\"",
    "build:next": "next build",
    "start:next": "next start",
    "typecheck": "tsc --noEmit",
    "build:approval-worker": "tsc -p scripts/tsconfig.approval-worker.json",
    "start:approval-worker": "node dist/approval-worker/scripts/combined-approval-worker.js",
    "env:validate": "ts-node scripts/validate-env.ts",
    "test:vault": "npm test -- --testPathPatterns=\"evidenceEncryption|keyEnvelope\"",
    "test:e2e:confidential": "node qa/node_modules/@playwright/test/cli.js test --config qa/playwright.e2e.config.ts",
    "demo:record": "node scripts/delivery/run.cjs",
    "dev:review": "node qa/dev/start.cjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
