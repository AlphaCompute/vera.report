# Local template only. Replace placeholders with your own development configuration.
# Copy to .env.backend.local for Docker Compose. Use development credentials only.
# This file is scoped to the backend service; never copy a production env file here.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=vera

# Include every frontend origin for this environment; production requires HTTPS.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Optional direct Slack notifications; see docs/security/README.md.
# Secret URL stays server-side. Example non-secret link: https://your-app.example/legal/organizations
SLACK_WEBHOOK_URL=
SLACK_ADMIN_URL=
IPFS_STORAGE_BACKEND=local-enclave
SHROUD_API_KEY=""
SHROUD_BASE_URL=https://dev-gateway.shroud.us
SHROUD_MODEL=nemotron-3-ultra
ENCRYPTION_MASTER_KEY=a-long-random-hex-string
REWARD_ENCRYPTION_KEY=a-long-random-string-for-encrypting-reward-contacts
INTERNAL_API_SECRET=a-long-random-hex-string
API_PORT=3001
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-client-id
AWS_REGION=us-east-2
SES_REGION=us-east-2
SES_SENDER_EMAIL=alerts@example.invalid
LOG_LEVEL=info
ADMIN_ALLOWED_DOMAINS=@yourcompany.com
TENANT_ORG_ID=org_xxxxxxxxxxxx
TENANT_NAME=Vera
DISSEMINATION_MODE=dryrun
DISSEMINATION_DRYRUN_INBOX=dissemination-test@your-domain.com
DISSEMINATION_SENDER_EMAIL=submissions@your-domain.com
DISSEMINATION_RECEIPT_DOMAIN=receipts.your-domain.com
DISSEMINATION_RELAY_ENABLED=false
DISSEMINATION_WEBHOOK_SECRET=a-long-random-hex-string
# Explicit trusted sender addresses by entity. Empty means manual receipt review.
DISSEMINATION_RECEIPT_SENDERS={}
SECURE_LINK_TTL_DAYS=7
DISSEMINATION_RECIPIENT_EMAILS={"whistleblower-org":"intake@example.org"}

# ── Confidential reports (OFF by default) ───────────────────────────────────
# Optional staff alerts (blank disables delivery; never reporter email).
# CONFIDENTIAL_SLACK_WEBHOOK_URL=
# CONFIDENTIAL_SLACK_ADMIN_URL=
# Optional legal application review webhook (staff-readable firm data only).
# SLACK_APPLICATION_WEBHOOK_URL=
# Worker-only Socket Mode settings (xapp app-level token with connections:write).
# Keep Socket Mode enabled in the webhook-owning Slack app; no public callback needed.
# SLACK_APPLICATION_APP_TOKEN=
# Isolated worker only: same app's xoxb token for the mandatory Key ID dialog.
# SLACK_APPLICATION_BOT_TOKEN=
# SLACK_APPLICATION_TEAM_ID=
# SLACK_APPLICATION_APPROVERS=
# Combined firm/key approval always uses the isolated worker documented in
# docs/security/README.md; no mode flag is required on the backend.
# Mount the authority key and private journal ONLY in that separate worker.
# Plaintext /submit and /analyze intake is refused by default. For a legacy
# deployment, explicitly set NEXT_PUBLIC_CONFIDENTIAL_CASES=0 in THIS backend's
# runtime environment as well as the frontend build. A frontend build argument
# alone does not enable legacy intake here. Either server-side flag set to true
# below still forbids plaintext, even with the explicit legacy selection.
# NEXT_PUBLIC_CONFIDENTIAL_CASES=0
# Enable confidential service hosting together with .env.frontend.example. Under
# NODE_ENV=production, CONFIDENTIAL_CASES_ENABLED=true is accepted only with
# DEPLOY_ENV=prod, staging or rehearsal (the terraform-prod stacks).
# See docs/security/README.md.
#
# Two layouts:
#  * Shared (local development): this legacy API (RUN_MODE=api) hosts the
#    confidential routes itself. Set CONFIDENTIAL_CASES_ENABLED=true and the
#    [task] settings below in this file; the database falls back to MONGODB_URI
#    and the admin "Encrypted" tab authenticates with INTERNAL_API_SECRET.
#  * Dedicated (deployed): a separate RUN_MODE=confidential task
#    (`node dist/confidentialServer.js`) serves them. This legacy API then only
#    sets CONFIDENTIAL_INTAKE_REQUIRED=true, and the [task] settings go in that
#    task's OWN environment, never in this file (see the constraints below).
#
# [api] Dedicated layout only: refuse plaintext intake here. Must be true when set.
# CONFIDENTIAL_INTAKE_REQUIRED=true
# [api+task] true or false. The task refuses to start unless it is true.
# CONFIDENTIAL_CASES_ENABLED=false
# [task] Dedicated confidential database cluster. Required by the task; the shared
# layout falls back to MONGODB_URI.
# CONFIDENTIAL_MONGODB_URI=mongodb://localhost:27017
# [api+task] Must differ from MONGODB_DB_NAME (default vera_confidential).
# CONFIDENTIAL_MONGODB_DB_NAME=vera_confidential
# [task] Header secret for the admin listing (the frontend sends the same value
# as CONFIDENTIAL_ADMIN_SECRET). At least 32 characters; generate with
# `openssl rand -hex 32`. Never reuse INTERNAL_API_SECRET.
# CONFIDENTIAL_ADMIN_SECRET=replace-with-64-hex-characters-from-openssl-rand
# [api+task] Path to the canonical release manifest file (the same JSON as the
# frontend's NEXT_PUBLIC_CONFIDENTIAL_RELEASE_MANIFEST). Required when enabled.
# CONFIDENTIAL_RELEASE_MANIFEST_FILE=/path/to/release-manifest.json
# [api+task] Optional path to the legal identity policy JSON
# (scripts/security/confidential-legal-identity-policy.cjs). Unset: legal
# organization operations stay off. A set but unreadable file fails closed.
# CONFIDENTIAL_LEGAL_IDENTITY_FILE=/path/to/legal-identity-policy.json
# [api+task] Optional signed release-withdrawal list file.
# CONFIDENTIAL_RELEASE_WITHDRAWALS_FILE=
# [api+task] Optional Roughtime relay allowlist (comma-separated host:port, the
# servers pinned in enclave/confidential-config.json "roughtime"; UDP egress).
# CONFIDENTIAL_ROUGHTIME_SERVERS=
# [api+task] Enclave session and storage channels: a Unix socket path, or a
# local TCP port (defaults 5004 and 5005) when the socket is unset.
# CONFIDENTIAL_ENCLAVE_SOCKET=
# CONFIDENTIAL_ENCLAVE_PORT=5004
# CONFIDENTIAL_STORAGE_SOCKET=
# CONFIDENTIAL_STORAGE_PORT=5005
# [api+task] Optional hourly ciphertext staging budget in bytes (default 2 GiB).
# CONFIDENTIAL_STAGING_HOURLY_BYTES=
# [task] Also reads API_PORT (default 3002), API_TRUST_PROXY_HOPS (0 to 9),
# CORS_ALLOWED_ORIGINS and MONGODB_TLS_CA_FILE.
#
# The task refuses to start (src/confidentialServer.ts,
# confidentialServerConfigurationError) unless RUN_MODE=confidential,
# CONFIDENTIAL_CASES_ENABLED=true, CONFIDENTIAL_MONGODB_URI is set,
# CONFIDENTIAL_ADMIN_SECRET has at least 32 characters, and NONE of the legacy
# secrets is present (MONGODB_URI, INTERNAL_API_SECRET, ENCRYPTION_MASTER_KEY,
# NULLIFIER_SEED, WALLET_ENCRYPTION_KEY, REWARD_ENCRYPTION_KEY, WALLET_SEED,
# MIDNIGHT_MNEMONIC, MIDNIGHT_RELAY_MNEMONIC, PINATA_JWT, VENICE_API_KEY,
# SHROUD_API_KEY, REDIS_URL, AUTH0_SECRET, AUTH0_CLIENT_SECRET,
# AUTH0_MGMT_CLIENT_SECRET, DISSEMINATION_WEBHOOK_SECRET,
# RECIPIENT_CAPABILITY_SECRET, WEBHOOK_SECRET, SLACK_WEBHOOK_URL,
# KMS_AT_REST_KEY_ID). That is why the task cannot load this file.

# [confidential task only] Dedicated legal-tenant M2M client for approved applications.
# Required M2M grants: read:organizations create:organizations
# read:organization_connections create:organization_connections
# read:organization_members create:organization_members read:users
# read:roles read:organization_member_roles create:organization_member_roles update:organizations.
# Keep credentials and the login connection together. Invitation client_id comes
# from clientId in CONFIDENTIAL_LEGAL_IDENTITY_FILE (the existing legal SPA policy).
# Its issuer must belong to this tenant; its clientId must not identify the M2M.
# Use the canonical tenant hostname below, even when the issuer is a custom domain.
# LEGAL_AUTH0_MGMT_DOMAIN=your-legal-tenant.auth0.com
# LEGAL_AUTH0_MGMT_CLIENT_ID=your-dedicated-legal-m2m-client-id
# LEGAL_AUTH0_MGMT_CLIENT_SECRET=your-dedicated-legal-m2m-secret
# Required existing email connection enabled for the legal SPA; no automatic domain membership.
# LEGAL_AUTH0_CONNECTION_ID=con_existingLegalConnection
# These existing settings enable Auth0-only sign-in and the membership worker
# automatically. Actions use a separate read-only M2M; see docs/security/README.md.

# ── Recipient links ─────────────────────────────────────────────────────────
# Independent >=32 random bytes; never reuse webhook/internal credentials. v2 links must be reissued.
RECIPIENT_CAPABILITY_SECRET=

# CloudFront -> origin-restricted ALB -> API uses 2; local single-proxy default is 1.
API_TRUST_PROXY_HOPS=1

# Dedicated approval worker's private API credential; independent from every
# frontend/admin, entry and M2M credential (at least 32 random characters).
# Share only with the isolated worker. See docs/security/README.md.
# LEGAL_APPROVAL_BACKEND_SECRET=
