{
  "format": "vera-confidential-configuration/v1",
  "enabled": false,
  "description": "Unconfigured source distribution. Configure and verify your own measured identity policies before enabling confidential cases. Use npm run dev:review for the synthetic local stack.",
  "protocolVersion": "vera-confidential-channel/v1",
  "dataFormatVersion": "vera-confidential-case/v1",
  "channelAudience": "vera-confidential-cases",
  "enclave": {
    "entrypoint": "/app/entrypoint.sh",
    "server": "/app/dist/confidential-server.js",
    "debugMode": false
  },
  "vsock": {
    "session": {
      "port": 5004,
      "direction": "parent-to-enclave",
      "purpose": "Opaque attested session frames (open, call); every private byte is encrypted to the attested channel key",
      "maxFrameBytes": 1048576
    },
    "storage": {
      "port": 5005,
      "parentCid": 3,
      "direction": "enclave-to-parent",
      "purpose": "Untrusted ciphertext storage RPC; the parent also supplies the release manifest, which the enclave verifies against its own NSM PCRs",
      "maxFrameBytes": 50331648,
      "methods": [
        "putObjects",
        "getStagedObject",
        "getObjects",
        "getEnvelopes",
        "readGrantedObjects",
        "createCase",
        "getCase",
        "commitTransition",
        "listListedCases",
        "putAccessRequest",
        "insertAccessRequestAtCheckpoint",
        "listAccessRequests",
        "getAccessRequest",
        "expireAccessRequests",
        "countAccessRequests",
        "withdrawAccessRequest",
        "declineAccessRequest",
        "answerAccessRequest",
        "appendMessage",
        "listMessages",
        "readInboxAtCheckpoint",
        "readMessagesAtCheckpoint",
        "readMailboxPageAtCheckpoint",
        "countMessages",
        "getOwnerEnvelopes",
        "listLegalOrganizations",
        "promoteChunks",
        "readObjectChunk",
        "getMember",
        "getOrganization",
        "getInvitation",
        "commitEnrollment",
        "insertInvitation",
        "upsertLegalOrganization",
        "getApplicationApproval",
        "registerFirstApplicationKey",
        "queueFirstApplicationKeyReview",
        "getLegalOrganizationKeySetup",
        "submitLegalOrganizationKeyCandidate",
        "inviteLegalOrganizationMember",
        "putFirmDeviceMembership",
        "countMembers",
        "listFirmDevices",
        "getFirmDevice",
        "putFirmDevice",
        "removeFirmDevice",
        "getFirmSharedList",
        "putFirmSharedList",
        "getOrganizationSetup",
        "putOrganizationSetup",
        "listMembers"
      ]
    }
  },
  "custody": {
    "caseSecretsOnHost": false,
    "kmsKeysForConfidentialCases": false,
    "stateKeyHolders": [
      "case-owner",
      "currently-granted-firm"
    ],
    "enclaveStateKeyPersistence": "memory-only"
  },
  "ownerOperations": [
    "case.challenge",
    "case.release-approvals",
    "case.recovery-package",
    "case.publish-case",
    "case.decline-request",
    "case.commit-transition",
    "case.unlock-case",
    "case.read-state-keys",
    "case.read-inbox",
    "case.read-owner-envelopes",
    "case.read-legal-roster",
    "case.read-state",
    "case.read-object"
  ],
  "firmOperations": [
    "legal.acknowledge-report-open",
    "legal.activate-application",
    "legal.challenge",
    "legal.device-enroll",
    "legal.device-register",
    "legal.device-status",
    "legal.directory",
    "legal.enroll",
    "legal.enrollment-challenge",
    "legal.firm-invite-member",
    "legal.firm-list-read",
    "legal.firm-list-write",
    "legal.issue-invitation",
    "legal.member-approve",
    "legal.member-remove",
    "legal.members",
    "legal.members-rotate",
    "legal.membership",
    "legal.open-case",
    "legal.organization-key",
    "legal.read-state-keys",
    "legal.release-approvals",
    "legal.replace-organization-key",
    "legal.request-access",
    "legal.request-status",
    "legal.request-status-batch",
    "legal.setup-record",
    "legal.setup-status",
    "legal.submit-organization-key",
    "legal.unlock-case",
    "legal.withdraw-request"
  ],
  "legalIdentityPolicySha256": null,
  "legalAdministration": null,
  "releaseWithdrawal": null,
  "roughtime": null
}
